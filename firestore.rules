rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role detection (requires a staff/admins collection)
    function isStaff() {
      return isEmailVerified() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    match /{path=**}/statusLogs/{logId} {
      allow read, write: if true;
    }

    // --- Entity Validations ---

    function isValidGuest(data) {
      return data.keys().hasAll(['fullName']) && 
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['number', 'type', 'status', 'price']) &&
             data.number is string && data.number.size() > 0 &&
             data.status in ['AVAILABLE', 'OCCUPIED', 'CLEANING', 'MAINTENANCE'] &&
             data.price is int && data.price >= 0;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['guestId', 'roomId', 'checkIn', 'checkOut']) &&
             isValidId(data.guestId) && isValidId(data.roomId) &&
             data.checkIn is timestamp && data.checkOut is timestamp &&
             data.checkOut > data.checkIn;
    }

    // --- Collection Routes ---

    match /guests/{guestId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;

      match /statusLogs/{logId} {
        allow read, write: if true;
      }
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
